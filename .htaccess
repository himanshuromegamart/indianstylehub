# ==============================================================================
# NARIFASHIONSTORE CPANEL PERFORMANCE & PASSENGER WORKER OPTIMIZATION
# ==============================================================================

# DO NOT REMOVE CPANEL PASSENGER DIRECTIVES
PassengerAppRoot "/home/narifash/narifashionstore"
PassengerBaseURI "/"
PassengerPython "/home/narifash/virtualenv/narifashionstore/3.11/bin/python"

# ------------------------------------------------------------------------------
# 1. PASSENGER WORKER PROCESS OPTIMIZATION (Speed & Concurrency)
# ------------------------------------------------------------------------------
# Keep at least 3 workers permanently alive in RAM (Eliminates 5-10s Cold Starts!)
PassengerMinInstances 3

# Never shut down idle workers (0 = unlimited idle time)
PassengerPoolIdleTime 0

# Allow scaling up to 6 concurrent worker processes under traffic spikes
PassengerMaxPoolSize 6

# Pre-warm the application in memory before first visitor arrives
PassengerPreStart https://www.narifashionstore.com/
PassengerPreStart https://narifashionstore.com/

# ------------------------------------------------------------------------------
# 2. DIRECT STATIC ASSET SERVING VIA LITESPEED / APACHE (Bypasses Python WSGI)
# ------------------------------------------------------------------------------
RewriteEngine On

# Directly serve static files from staticfiles_build if they exist on disk
RewriteCond %{DOCUMENT_ROOT}/staticfiles_build/static/$1 -f
RewriteRule ^static/(.*)$ /staticfiles_build/static/$1 [L]

# Directly serve media uploads from media directory if they exist on disk
RewriteCond %{DOCUMENT_ROOT}/media/$1 -f
RewriteRule ^media/(.*)$ /media/$1 [L]

# ------------------------------------------------------------------------------
# 3. GZIP / BROTLI COMPRESSION & BROWSER CACHING (Fast Repeat Visits)
# ------------------------------------------------------------------------------
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/json application/xml image/svg+xml
</IfModule>

<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresDefault "access plus 1 month"
    ExpiresByType text/html "access plus 0 seconds"
    ExpiresByType text/css "access plus 1 month"
    ExpiresByType application/javascript "access plus 1 month"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType font/woff2 "access plus 1 year"
</IfModule>

<IfModule mod_headers.c>
    <FilesMatch "\.(ico|pdf|flv|jpg|jpeg|png|gif|webp|js|css|swf|woff2)$">
        Header set Cache-Control "max-age=2592000, public"
    </FilesMatch>
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

